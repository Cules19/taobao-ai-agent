SHOP_DOMAIN=shop.example.com
SHOP_SESSION_SECRET=
SHOP_ACCESS_USER=reviewer
# Use single quotes around the bcrypt hash to prevent interpolation of dollar signs.
SHOP_ACCESS_PASSWORD_HASH=''
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
SHOP_VISITOR_LIMIT=12
SHOP_SITE_LIMIT=120
SHOP_DAILY_LIMIT=600
SHOP_RETENTION_DAYS=7
SHOP_KB_MIN_SCORE=0.65
# Local CLI reads shell environment, not this file. Container paths are set in Dockerfile.
# SHOP_KB_INDEX=.shop-state/knowledge.json
# SHOP_EMBEDDING_CACHE=.shop-state/embeddings
# SHOP_EMBEDDING_MODEL_PATH=   # Optional predownloaded ONNX directory (local Python)
SHOP_LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=select-studio
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
